# ===== Server =====
PORT=4000
NODE_ENV=development
# Địa chỉ frontend (dùng cho CORS)
CLIENT_URL=http://localhost:3000

# ===== Database (PostgreSQL) =====
# Định dạng: postgresql://USER:PASSWORD@HOST:PORT/TEN_DATABASE
# Nếu mật khẩu có ký tự đặc biệt (@ : / # ...) thì phải encode, VD: @ -> %40
DATABASE_URL=postgresql://postgres:MAT_KHAU_CUA_BAN@localhost:5432/hung_cafe
# Đặt true khi dùng DB trên cloud (Neon, Render, Supabase...)
DATABASE_SSL=false

# ===== Auth =====
# Chuỗi bí mật để ký JWT — tạo bằng: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=thay_bang_chuoi_ngau_nhien_that_dai
JWT_EXPIRES_IN=7d

# ===== Tài khoản mẫu tạo bởi "npm run db:setup" (chỉ dùng khi học / dev) =====
SEED_ADMIN_EMAIL=admin@hungcafe.vn
SEED_ADMIN_PASSWORD=Admin@123
SEED_CUSTOMER_EMAIL=khach@hungcafe.vn
SEED_CUSTOMER_PASSWORD=Khach@123

# Mật khẩu chung của các tài khoản khách demo (tạo thêm bằng script dữ liệu demo, nếu có)
SEED_DEMO_PASSWORD=Demo@2026

# ===== Thanh toán VNPay (môi trường thử — sandbox) =====
# Đăng ký miễn phí tại trang sandbox của VNPay → VNPay gửi qua email 2 mã dưới đây.
# Để trống thì web chỉ có "Thanh toán khi nhận hàng". KHÔNG đưa khoá bí mật lên GitHub.
VNP_TMN_CODE=
VNP_HASH_SECRET=
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# Trang khách quay về sau khi thanh toán (frontend)
VNP_RETURN_URL=http://localhost:3000/thanh-toan/ket-qua
# Quá bao nhiêu phút chưa thanh toán thì tự huỷ đơn
PAYMENT_TIMEOUT_MINUTES=15

# ===== Lưu ảnh món trên Cloudinary (cloud lưu ảnh, miễn phí) =====
# Đăng ký tại https://cloudinary.com → Settings (⚙) → API Keys → copy 3 thông tin dưới đây.
# Để trống thì ảnh admin upload lưu vào ổ cứng máy chủ (thư mục backend/uploads) như cũ.
# Khi deploy (Render xoá ổ cứng mỗi lần deploy lại) NÊN điền để ảnh không bị mất.
# API_SECRET giống mật khẩu: KHÔNG gửi cho ai, KHÔNG đưa lên GitHub.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
