# ===== Server =====
PORT=4000
NODE_ENV=development
# Địa chỉ frontend (dùng cho CORS)
CLIENT_URL=http://localhost:3000

# ===== Database (PostgreSQL) =====
# Định dạng: postgresql://USER:PASSWORD@HOST:PORT/TEN_DATABASE
# Nếu mật khẩu có ký tự đặc biệt (@ : / # ...) thì phải encode, VD: @ -> %40
DATABASE_URL=postgresql://postgres:MAT_KHAU_CUA_BAN@localhost:5432/hung_cafe
# Đặt true khi dùng DB trên cloud (Neon, Render, Supabase...)
DATABASE_SSL=false

# ===== Auth =====
# Chuỗi bí mật để ký JWT — tạo bằng: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=thay_bang_chuoi_ngau_nhien_that_dai
JWT_EXPIRES_IN=7d

# ===== Tài khoản mẫu tạo bởi "npm run db:setup" (chỉ dùng khi học / dev) =====
SEED_ADMIN_EMAIL=admin@hungcafe.vn
SEED_ADMIN_PASSWORD=Admin@123
SEED_CUSTOMER_EMAIL=khach@hungcafe.vn
SEED_CUSTOMER_PASSWORD=Khach@123
