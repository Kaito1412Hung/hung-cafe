# Địa chỉ backend Node.js (Next.js sẽ chuyển tiếp /api/* tới đây)
BACKEND_URL=http://localhost:4000
# Địa chỉ website (dùng cho ảnh chia sẻ link). Khi deploy đổi thành tên miền thật
SITE_URL=http://localhost:3000
# Địa chỉ backend cho realtime (Socket.IO). Trình duyệt nối THẲNG vào đây vì Vercel không chuyển tiếp được WebSocket.
# Khi deploy: link Render, VD https://hung-cafe-api.onrender.com (đổi xong phải deploy lại Vercel vì biến NEXT_PUBLIC_ được gắn lúc build)
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
